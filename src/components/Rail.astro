---
import CursorText from "./CursorText.astro";
import { withBase, stripBase } from "../lib/href";
import.meta.env.BASE_URL

/**
 * Fixed vertical nav down the left edge. Items are packed to the bottom and
 * read bottom-to-top, so the name sits lowest and the list runs up from it.
 *
 * The active item is marked with aria-current="page", which is both the
 * correct semantics and the styling hook the block cursor keys off.
 *
 * A detail route has no rail item of its own, so `match` lists the path
 * prefixes that should light a section: an individual project keeps `work`
 * lit, an individual post keeps `writing` lit.
 */
export interface RailItem {
  label: string;
  href: string;
  /** Extra path prefixes that count as "inside" this section. */
  match?: string[];
  /**
   * Phone-width label. Four full labels do not fit across a 320px bar, and
   * the name is by far the longest. Defaults to `label`.
   */
  short?: string;
}

interface Props {
  items?: RailItem[];
}

const DEFAULT_ITEMS: RailItem[] = [
  { label: "contact", href: "/contact" },
  { label: "writing", href: "/writing", match: ["/posts"] },
  { label: "work", href: "/work", match: ["/projects"] },
  { label: "seven flaminiano", href: "/", short: "seven" },
];

const { items = DEFAULT_ITEMS } = Astro.props;

// Astro.url.pathname carries the deploy base ("/portfolio/work"), while
// item.href is written bare ("/work"), so strip the base before comparing.
// Trailing slashes vary with build config, so normalise those too. "/" must
// match exactly or it would claim every route.
const path = stripBase(Astro.url.pathname).replace(/\/+$/, "") || "/";

function isCurrent(item: RailItem): boolean {
  const prefixes = [item.href, ...(item.match ?? [])];
  return prefixes.some((prefix) => {
    const p = prefix.replace(/\/+$/, "") || "/";
    return p === "/" ? path === "/" : path === p || path.startsWith(`${p}/`);
  });
}

const active = items.find(isCurrent);
---

<nav class="rail" aria-label="Primary">
  {
    items.map((item) => (
      <a
        href={withBase(item.href)}
        class:list={["rail-item", { name: item.href === "/" }]}
        aria-current={item === active ? "page" : undefined}
      >
        <span class="lbl lbl-full"><CursorText text={item.label} /></span>
        <span class="lbl lbl-short"><CursorText text={item.short ?? item.label} /></span>
      </a>
    ))
  }
</nav>

<style>
  .rail {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--rail);
    z-index: 5;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-6);

    padding-block: var(--sp-5) var(--sp-5);
    border-inline-end: 1px solid var(--rule);

    font-size: var(--s-sm);
  }

  /* vertical-rl lays the text down the column; the 180deg turn flips it so
     it reads bottom-to-top rather than top-to-bottom. */
  .rail-item {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    color: var(--fg-dim);
    transition: color 120ms linear;
  }

  .rail-item:hover,
  .rail-item[aria-current] {
    color: var(--fg);
  }

  .name {
    color: var(--fg);
  }

  .lbl-short { display: none; }

  /* Phones: the vertical bar costs about a tenth of a 375px viewport and
     sideways text is genuinely harder to read, so the rail becomes a bottom
     bar. Bottom rather than top because it is thumb-reachable. Reading order
     is preserved: the name still comes first.

     The block cursor needs no changes. Its ::before is inset:0 on a
     one-character span, so it is correct in either writing mode. */
  @media (max-width: 760px) {
    .rail {
      inset-block: auto 0;
      inset-inline: 0;
      width: auto;
      height: var(--rail-h);

      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--sp-3);

      padding-block: 0;
      padding-inline: var(--sp-5);

      border-inline-end: none;
      border-block-start: 1px solid var(--rule);

      /* Opaque: content scrolls underneath it. */
      background: var(--bg);
    }

    .rail-item {
      writing-mode: horizontal-tb;
      transform: none;

      /* Stretch to the bar height so the tap target is 52px tall even
         though the text is 13px. */
      display: flex;
      align-items: center;
      align-self: stretch;
    }

    /* Four labels total ~34 characters. At 13px in a 0.5em-advance face
       that is ~220px, which clears a 320px viewport once padding and gaps
       are taken out. Shrink rather than overflow if a label grows: pass
       shorter `items` to <Rail> if you ever need to. */
    /* Never squeeze. If labels ever outgrow the bar it should be obvious
       in testing rather than silently clipping the first item. */
    .rail-item {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .lbl-full { display: none; }
    .lbl-short { display: inline; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-item { transition: none; }
  }
</style>
