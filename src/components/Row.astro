---
import CursorText from "./CursorText.astro";
import { withBase } from "../lib/href";

/**
 * One line in a listing: title, optional blurb, optional trailing meta.
 *
 * Listings are rows separated by hairline rules rather than a grid of
 * cards. Cards over an animated background create a second layer competing
 * for attention on every frame; a text list stays quiet and scans faster.
 *
 * Wrap a group of these in <div class="rows"> for the shared top border.
 *
 * `href` is passed through withBase(), so callers write bare root-relative
 * paths ("/projects/foo") and the deploy base is applied here. Absolute URLs
 * and anchors pass through untouched.
 */
interface Props {
  href: string;
  title: string;
  blurb?: string;
  meta?: string;
  /** Nerd Font glyph, from `icon` in src/lib/site.ts. Decorative only. */
  icon?: string;
  /** Save the target instead of navigating. Same-origin files only. */
  download?: boolean;
  /** Force new-tab behaviour on or off. Defaults to true for http(s) links. */
  newTab?: boolean;
  /** Shown under the blurb, truncated to `maxTags`. */
  tags?: string[];
  /** How many tags a row shows before collapsing the rest into a count. */
  maxTags?: number;
}

const {
  href, title, blurb, meta, icon, download, newTab,
  tags = [], maxTags = 3,
} = Astro.props;

// A row is a scanning surface, so the tag list is capped rather than wrapped.
// The remainder is surfaced as a count so it is clear something was elided
// instead of the list just looking short.
const shown = tags.slice(0, maxTags);
const hidden = tags.length - shown.length;

// A bare "https://" or "mailto:" is left alone by withBase, so external and
// internal links can share this component.
const isExternal = /^[a-z][a-z0-9+.-]*:/i.test(href) && !href.startsWith("/");

// Only web links open in a tab. A mailto: or tel: hands off to another
// application, and target="_blank" there can strand an empty tab behind.
// `download` wins over target anyway, so exclude it too.
const isHttp = /^https?:/i.test(href);
const opensNewTab = newTab ?? (isHttp && !download);
---

<a
  class="row"
  href={withBase(href)}
  download={download ? "" : undefined}
  target={opensNewTab ? "_blank" : undefined}
  rel={isExternal ? "noopener" : undefined}
>
  <span class="body">
    <span class="title">
      {icon && <span class="icon" aria-hidden="true">{icon}</span>}
      <CursorText text={title} />
    </span>

    {blurb && <span class="blurb">{blurb}</span>}
    {shown.length > 0 && (
      <span class="tags">
        {shown.map((tag) => <span>{tag}</span>)}
        {hidden > 0 && <span class="more">+{hidden}</span>}
      </span>
    )}
  </span>
  {meta && <span class="meta">{meta}</span>}
  {/* WCAG 3.2.5: a link that changes context should say so. The icon is
      aria-hidden, so without this a screen reader gets no warning. */}
  {opensNewTab && <span class="sr-only">(opens in a new tab)</span>}
</a>

<style>
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-5);
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--rule);
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .title {
    font-size: var(--s-md);
  }

  /* Fixed 2ch box so labels align down the column regardless of how wide
     each glyph draws. aria-hidden, because the adjacent text already names
     the link and a screen reader would otherwise announce a PUA codepoint. */
  .icon {
    display: inline-block;
    width: 2ch;
    color: var(--fg-dim);
  }

  .row:hover .icon {
    color: var(--accent);
  }

  .blurb {
    margin-top: var(--sp-1);
    font-size: var(--s-sm);
    color: var(--fg-dim);
  }

  .tags {
    margin-top: var(--sp-2);
  }

  .more {
    opacity: 0.7;
  }

  .meta {
    flex: none;
    font-size: var(--s-sm);
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
    /* "2025-06-14" must not break across lines when the title wraps. */
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .row { gap: var(--sp-3); }
  }
</style>
