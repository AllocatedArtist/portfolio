---
import "../styles/global.css";
import Rail from "../components/Rail.astro";
import ShaderBackground from "../components/ShaderBackground.astro";
import type { RailItem } from "../components/Rail.astro";
import { withBase } from "../lib/href";

// Imported rather than written as literal paths so Vite emits the hashed,
// base-prefixed URL. These must resolve to the same files the @font-face
// rules in global.css reference, or the preload is wasted and fetches twice.
import zedRegular from "../assets/fonts/zedmono-regular.woff2?url";
import zedMedium from "../assets/fonts/zedmono-medium.woff2?url";

/**
 * The page shell. Every route renders through this.
 *
 * The default slot lands inside the left-pinned content column, so pages
 * only supply their own content and never repeat the layout.
 */
interface Props {
  title: string;
  description?: string;
  /** Social preview image. Needs an absolute URL, so it is resolved below. */
  image?: ImageMetadata;
  /** Override the nav; see Rail.astro for the shape. */
  railItems?: RailItem[];
}

const { title, description, image, railItems } = Astro.props;

const SITE = "Seven Flaminiano";
const heading = title === SITE ? SITE : `${title} — ${SITE}`;

// Astro.site is set in astro.config.mjs; guard anyway so a missing value
// degrades to no canonical rather than throwing during the build.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{heading}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <!-- Same-origin and small, but still worth fetching in parallel with the
         stylesheet: the whole page is set in this one face, so a late font
         means a reflow of everything at once. -->
    <link rel="preload" href={zedRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={zedMedium} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={heading} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {
      image && Astro.site && (
        <>
          {/* Crawlers will not resolve a relative path, so this has to be
              absolute even though every other URL on the page is not. */}
          <meta property="og:image" content={new URL(image.src, Astro.site).href} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    {/* GoatCounter. No cookies and no fingerprinting, so no consent banner.
        `is:inline` keeps Astro from bundling it: the data-goatcounter
        attribute is the config, and it has to survive to the shipped tag.

        PROD-gated so `npm run dev` does not pollute the numbers. count.js
        also ignores localhost on its own, which covers `astro preview`.

        Uniques come from a hash that rotates daily, so the same person
        returning next week counts twice. Read it as direction, not headcount. */}
    {
      import.meta.env.PROD && (
        <script
          is:inline
          async
          src="https://gc.zgo.at/count.js"
          data-goatcounter="https://allocatedartist.goatcounter.com/count"
        />
      )
    }
  </head>

  <body>
    <ShaderBackground />
    <Rail items={railItems} />

    <main class="shell">
      <div class="col">
        <slot />
      </div>
    </main>
  </body>
</html>
