---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Row from "../components/Row.astro";

/**
 * Home.
 *
 * The content below is placeholder, hardcoded on purpose. This page exists
 * to show every styled primitive in one place while the content pipeline is
 * still being written; swap these arrays for getCollection() calls when the
 * collections have entries.
 *
 * Note that getCollection returns [] for a missing collection directory, so
 * guard before indexing rather than assuming projects[0] exists.
 */

const projects = await getCollection('projects');
const posts = await getCollection('blog');
---

<Base
  title="Seven Flaminiano"
  description="Graphics and engine enthusiast."
>
  <div class="stack intro">
    <h1>Graphics and game engine programmer</h1>
    <p class="lede">
    I enjoy graphics, systems, and low-level programming. Mostly
      C and C++.
    </p>
  </div>

  <section class="stack section">
    <h2 class="eyebrow">Selected work</h2>
    <div class="rows">
      {
        projects.map((project) => (
          <Row
            href={`/projects/${project.id}`}
            title={project.data.title}
            blurb={project.data.blurb}
            meta={String(project.data.date.getFullYear())}
          />
        ))
      }
    </div>
  </section>

  <section class="stack section">
    <h2 class="eyebrow">Writing</h2>
    <div class="rows">
      {
        posts.map((post) => (
        <Row 
          href={`/blogs/${post.id}`} 
          title={post.data.title} 
          meta={post.data.date.getFullYear()} 
        />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    gap: var(--sp-3);
    margin-top: clamp(24px, 6vh, 64px);
  }

  .section {
    gap: var(--sp-2);
    margin-top: clamp(40px, 8vh, 80px);
  }
</style>
