---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Row from "../components/Row.astro";
import { year } from "../lib/date";

import { site } from "../lib/site.ts"

const projects = await getCollection('projects', p => p.data.featured);
---

<Base
  title="Seven Flaminiano"
  description={site.role}
>
  <div class="stack intro">
    <h1>{site.role}</h1>
    <p class="lede">
      I write engines and the low-level systems underneath them. Mostly
      C and C++.
    </p>
    <p class="note desktop-hint">
      The background of this site is a path tracer, rendering live in your
      browser. It is switched off here to spare your battery. Open the site
      on a desktop to see it.
    </p>
  </div>

  <section class="stack section">
    <h2 class="eyebrow">Selected work</h2>
    <div class="rows">
      {
        projects.map((project) => (
          <Row
            href={`/projects/${project.id}`}
            title={project.data.title}
            blurb={project.data.blurb}
            meta={year(project.data.date)}
            tags={project.data.tags}
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    gap: var(--sp-3);
    margin-top: clamp(24px, 6vh, 64px);
  }

  .section {
    gap: var(--sp-2);
    margin-top: clamp(40px, 8vh, 80px);
  }

  /* Shown exactly where background.ts declines to render: touch-primary
     devices. `pointer: coarse` reports the primary input rather than the
     available inputs, so a touchscreen laptop reads as fine, keeps the
     shader, and never sees this. It is also orientation-independent, which
     a width query would not be — a phone on its side is wider than the
     760px breakpoint and would otherwise slip through. */
  .desktop-hint {
    display: none;
  }

  @media (pointer: coarse) {
    .desktop-hint {
      display: block;
      margin-top: var(--sp-2);
    }
  }
</style>
