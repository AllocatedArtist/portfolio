---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Row from "../components/Row.astro";
import { year } from "../lib/date";

import { site } from "../lib/site.ts"

const projects = await getCollection('projects', p => p.data.featured);
---

<Base
  title="Seven Flaminiano"
  description={site.role}
>
  <div class="stack intro">
    <h1>{site.role}</h1>
    <p class="lede">
      I write engines and the low-level systems underneath them. Mostly
      C and C++.
    </p>
    <p class="note rotate">
      The background is a path tracer running in your browser. It is framed
      for a wide viewport. Turn your phone sideways for the full scene.
    </p>
  </div>

  <section class="stack section">
    <h2 class="eyebrow">Selected work</h2>
    <div class="rows">
      {
        projects.map((project) => (
          <Row
            href={`/projects/${project.id}`}
            title={project.data.title}
            blurb={project.data.blurb}
            meta={year(project.data.date)}
            tags={project.data.tags}
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    gap: var(--sp-3);
    margin-top: clamp(24px, 6vh, 64px);
  }

  .section {
    gap: var(--sp-2);
    margin-top: clamp(40px, 8vh, 80px);
  }

  /* Only worth saying on a device that can actually be turned. Gated on the
     760px breakpoint as well as orientation so a tall, narrow desktop window
     does not get told to rotate a phone it does not have.

     The shader itself keys off portrait alone, so a narrow desktop window
     still gets the repositioned camera — it just does not get the note. */
  .rotate {
    display: none;
  }

  @media (orientation: portrait) and (max-width: 760px) {
    .rotate {
      display: block;
      margin-top: var(--sp-2);
    }
  }
</style>
