---
import { getCollection, render } from "astro:content";
import { withBase } from "../../lib/href";
import Base from "../../layouts/Base.astro";
import { longDate, machineDate } from "../../lib/date";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

// Derived, not authored. A project declares which post writes it up; the
// reverse link falls out of that, so there is only ever one side to keep in
// sync and a post cannot claim a project that does not point back.
const projects = await getCollection("projects", (p) => p.data.post?.id === post.id);

// The tex loader stores the pandoc output under `rendered`, so posts render
// exactly like markdown entries. `headings` comes from rendered.metadata if
// you ever want to build a table of contents in Astro rather than pandoc.
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.blurb}>
  <header class="masthead">
    <h1>{post.data.title}</h1>
    <time class="meta" datetime={machineDate(post.data.date)}>
      {longDate(post.data.date)}
    </time>
  </header>

  {projects.length > 0 && (
    <p class="meta refs">
      {projects.map((project) => (
        <a class="link" href={withBase(`/projects/${project.id}`)}>
          {project.data.title}
        </a>
      ))}
    </p>
  )}

  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  /* Same bottom margin as the project page's .details, so a post with a
     backlink and a project with tags space their bodies identically. */
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-block-end: var(--sp-6);
  }
</style>
