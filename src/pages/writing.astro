---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Row from "../components/Row.astro";
import { year } from "../lib/date";

const blogs = await getCollection('blog');
---

<Base 
  title="Writing"
  description="My personal notes."
>
  <header class="masthead">
    <h1>Writing</h1>
    <p class="note">
    These are my personal notes on what I build written to help
    me internalize new information, not to teach it. So, if you catch
    a mistake, feel free to email me.
    </p>
  </header>
  <div class="rows">
    {
      blogs.map((blog) => (
        <Row
          href={`/blogs/${blog.id}`}
          title={blog.data.title}
          blurb={blog.data.blurb}
          meta={year(blog.data.date)}
        />
      ))
    }
  </div>
</Base>
