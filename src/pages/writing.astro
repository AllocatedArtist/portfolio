---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Row from "../components/Row.astro";
import { year } from "../lib/date";

const posts = await getCollection('posts');
---

<Base 
  title="Writing"
  description="My personal notes."
>
  <header class="masthead">
    <h1>Writing</h1>
    <p class="note">
    These are my personal notes on what I build written to help
    me internalize new information, not to teach it. If you catch
    a mistake, feel free to email me.
    </p>
  </header>
  <div class="rows">
    {
      posts.map((post) => (
        <Row
          href={`/posts/${post.id}`}
          title={post.data.title}
          blurb={post.data.blurb}
          meta={year(post.data.date)}
        />
      ))
    }
  </div>
</Base>
